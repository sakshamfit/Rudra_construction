# GEMINI_API_KEY: Required for Gemini AI API calls (optional; the site works without it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin of the site, e.g. https://example.com (no trailing slash).
# Used by scripts/generate-seo.mjs for canonical/OG/sitemap URLs. When unset, the
# generator emits __SITE_ORIGIN__ placeholders that server.js / vite inject the
# request origin into at serve time.
APP_URL="MY_APP_URL"

# India (Asia/Kolkata) deploy environment — hosting locale and timezone.
# Company headquarters, GSTIN, CIN and project data remain Bihar, India.
TZ=Asia/Kolkata
LANG=en_IN.UTF-8
LC_ALL=en_IN.UTF-8
SITE_LOCALE=en-IN
DEPLOY_REGION=asia-south1
DEPLOY_COUNTRY=IN
PORT=3000
HOST=0.0.0.0

# Admin console at /admin — change after first login.
ADMIN_PASSWORD=RudraAdmin@2025

# SESSION_SECRET (optional, recommended for multi-instance hosting): signs the
# admin session tokens. Sessions are stateless (HMAC-signed cookies), so login
# survives cold starts, restarts and other serverless instances even without
# this — but an explicit secret keeps tokens valid across password-hash
# rotations of the seed data. Any long random string works.
# SESSION_SECRET="change-me-to-a-long-random-string"

# --- Durable storage for Vercel deploys (recommended) -----------------------
# Vercel serverless functions have an EPHEMERAL filesystem: without this,
# admin edits (turnover, photos, blogs, projects) are wiped on every cold
# start / redeploy. Fix: create a Vercel Blob in the dashboard
#   (project → Storage → "Add new" → Vercel Blob) — Vercel then injects
# BLOB_READ_WRITE_TOKEN into the project automatically. No file changes needed.
BLOB_READ_WRITE_TOKEN=""
# Only set these if you use a non-default blob endpoint / separate tokens.
BLOB_API_BASE="https://blob.vercel-storage.com"
# BLOB_READ_TOKEN=""
# BLOB_WRITE_TOKEN=""
