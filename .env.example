# GEMINI_API_KEY: Required for Gemini AI API calls (optional; the site works without it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin of the site, e.g. https://example.com (no trailing slash).
# Used by scripts/generate-seo.mjs for canonical/OG/sitemap URLs. When unset, the
# generator emits __SITE_ORIGIN__ placeholders that server.js / vite inject the
# request origin into at serve time.
APP_URL="MY_APP_URL"

# India (Asia/Kolkata) deploy environment — hosting locale and timezone.
# Company headquarters, GSTIN, CIN and project data remain Bihar, India.
TZ=Asia/Kolkata
LANG=en_IN.UTF-8
LC_ALL=en_IN.UTF-8
SITE_LOCALE=en-IN
DEPLOY_REGION=asia-south1
DEPLOY_COUNTRY=IN
PORT=3000
HOST=0.0.0.0

# Admin console at /admin — change after first login.
ADMIN_PASSWORD=RudraAdmin@2025
